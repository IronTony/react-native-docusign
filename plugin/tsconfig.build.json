{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./build",
    "rootDir": "./src",
    "declaration": true,
    "sourceMap": true
  },
  "include": ["./src"],
  "exclude": [
    "**/__mocks__/*",
    "**/__tests__/*",
    "**/*.test.ts",
    "build",
    "node_modules"
  ]
}
